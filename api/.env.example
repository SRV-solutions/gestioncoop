NODE_ENV=development
PORT=4100
# Cantidad de proxies delante de la API (1 en local con Vite; 2 en Railway detrás de Netlify)
TRUST_PROXY=1
# URL pública del front
APP_URL=http://localhost:5180
# Dominio base para resolver la cooperativa por subdominio (dosdemayo.<DOMINIO_BASE>). Opcional.
DOMINIO_BASE=
DATABASE_URL=postgres://coopgestion:coopgestion_dev@localhost:5440/coopgestion
# Base de los tests (npm test). Se vacía en cada corrida: tiene que terminar en _test.
TEST_DATABASE_URL=postgres://coopgestion:coopgestion_dev@localhost:5440/coopgestion_test
DATABASE_SSL=false
# Clave para firmar los tokens de acceso. En producción, una cadena larga y aleatoria (mínimo 32 caracteres).
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# Modo demo: muestra los botones "Entrar como..." y habilita los usuarios de prueba.
DEMO_MODE=true
# Clave de los usuarios de prueba (solo sirven con DEMO_MODE=true)
# Botones de «Modo demo» en la pantalla de ingreso, para entrar sin contraseña (true / false).
DEMO_ACCESO_RAPIDO=false
DEMO_PASSWORD=
# Cooperativa que se muestra cuando la dirección no trae subdominio
COOPERATIVA_POR_DEFECTO=dosdemayo
# Superadmin del proveedor (lo crea el seed si no existe)
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=
