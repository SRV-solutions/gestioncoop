NODE_ENV=development
PORT=4100
# Cantidad de proxies delante de la API (1 en local con Vite; 2 en Railway detrás de Netlify)
TRUST_PROXY=1
# URL pública del front
APP_URL=http://localhost:5180
# Dominio base para resolver la cooperativa por subdominio (dosdemayo.<DOMINIO_BASE>). Opcional.
DOMINIO_BASE=
DATABASE_URL=postgres://coopgestion:coopgestion_dev@localhost:5440/coopgestion
# Base de los tests (npm test). Se vacía en cada corrida: tiene que terminar en _test.
TEST_DATABASE_URL=postgres://coopgestion:coopgestion_dev@localhost:5440/coopgestion_test
DATABASE_SSL=false
# Clave para firmar los tokens de acceso. En producción, una cadena larga y aleatoria (mínimo 32 caracteres).
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# Modo demo: muestra los botones "Entrar como..." y habilita los usuarios de prueba.
DEMO_MODE=true
# Clave de los usuarios de prueba (solo sirven con DEMO_MODE=true)
# Botones de «Modo demo» en la pantalla de ingreso, para entrar sin contraseña (true / false).
DEMO_ACCESO_RAPIDO=false
DEMO_PASSWORD=
# Cooperativa que se muestra cuando la dirección no trae subdominio
COOPERATIVA_POR_DEFECTO=dosdemayo
# Superadmin del proveedor (lo crea el seed si no existe)
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# ── Claves propias (producción: obligatorias, 32 caracteres o más, y NO cambiarlas nunca) ──
# Cifra el certificado de ARCA de cada cooperativa y el permiso de acceso que entrega ARCA.
# Si cambia, hay que volver a cargar los certificados.
CLAVE_CIFRADO=
# Firma la cadena de integridad de facturas, cobros y registro de cambios. Si cambia, toda la
# cadena deja de cerrar. Guardala fuera de la base (en Railway, como variable del servicio).
CLAVE_INTEGRIDAD=
# En desarrollo, si quedan vacías, se derivan de JWT_SECRET.

# ── Integridad de los datos ──
# Hora (Argentina) de la verificación automática diaria. VERIFICACION_DIARIA=false la apaga.
VERIFICACION_HORA=03:30
VERIFICACION_DIARIA=true

# ── Mails (Resend) ──
# Sin clave no sale ningún mail: quedan registrados como simulados.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend. onboarding@resend.dev solo le llega al dueño de la cuenta.
CORREO_REMITENTE=GestiónCoop <onboarding@resend.dev>
# Los avisos de factura a los socios salen por mail de verdad (además de quedar en la bandeja).
AVISOS_SOCIOS_POR_CORREO=false

# ── ARCA (factura electrónica) ──
# El ambiente y el certificado de cada cooperativa se cargan desde el Panel de SRV, no acá.
# Solo si ARCA rechaza la conexión con «dh key too small» o similar:
ARCA_TLS_LEGACY=false
